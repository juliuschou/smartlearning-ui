# Disposable FE-4.3 browser acceptance configuration.
# Copy to test/browser/.env.local and source it in the shell before running Playwright.
# Never commit real credentials or the response-loss token.

FE42_API_BASE=http://localhost:3000/api/v1
FE42_UI_ORIGIN=http://localhost:3001
FE42_ADMIN_USERNAME=replace-with-disposable-admin
FE42_ADMIN_PASSWORD=replace-with-disposable-admin-password
FE42_COURSE_NAME_PREFIX=FE42 participant realtime
FE42_RESPONSE_LOSS_TOKEN=replace-with-random-test-token

# Optional: omit these to let the spec provision a disposable teacher.
# FE42_TEACHER_USERNAME=replace-with-disposable-teacher
# FE42_TEACHER_PASSWORD=replace-with-disposable-teacher-password

# The Next.js server must use the same API base as the browser fixture:
# NEXT_PUBLIC_API_BASE=$FE42_API_BASE
