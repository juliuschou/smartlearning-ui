# Disposable FE-5.1 real-backend browser acceptance fixture.
# Keep the populated dotenv file outside git and never record credentials/tokens.
# Do not `source`/`eval` this file; pass it to Compose with --env-file and load
# the same values into the Playwright process without shell re-parsing.
# Fixture API calls use the direct backend base. Browser calls use the HTTPS
# same-origin /api/v1 proxy configured by Playwright + Next rewrites.
FE51_API_BASE=http://localhost:3000/api/v1
FE51_UI_ORIGIN=https://localhost:3443
FE51_ADMIN_USERNAME=replace-with-isolated-admin
FE51_ADMIN_PASSWORD=replace-with-isolated-admin-password
FE51_COURSE_NAME_PREFIX="FE51 isolated"
FE51_RESPONSE_LOSS_TOKEN=replace-with-random-test-token

# Optional: omit to let the browser spec provision a disposable teacher.
# FE51_TEACHER_USERNAME=replace-with-isolated-teacher
# FE51_TEACHER_PASSWORD=replace-with-isolated-teacher-password

# Backend Compose inputs (source the same values for the runtime).
FE51_DB_USERNAME=smartlearning
FE51_DB_PASSWORD=replace-with-disposable-db-password
FE51_DB_PORT=55451
FE51_COOKIE_SECRET=replace-with-disposable-cookie-secret
FE51_BACKEND_PORT=3000
